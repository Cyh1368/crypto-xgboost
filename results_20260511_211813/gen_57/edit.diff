     # --- Additional Signal Features ---
     feat['log_vol'] = np.log1p(volume)
     feat['vol_expansion'] = log_ret.rolling(5).std() / (log_ret.rolling(60).std() + 1e-9)
     feat['vwap_dev_std'] = (close - vwap) / (close.rolling(20).std() + 1e-9)
