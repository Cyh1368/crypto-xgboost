     feat['price_accel'] = log_ret.diff(1)
     feat['range_pos_10'] = (close - low.rolling(10).min()) / (high.rolling(10).max() - low.rolling(10).min() + 1e-9)
     feat['rolling_skew_30'] = log_ret.rolling(30).skew()
     feat['rolling_kurt_30'] = log_ret.rolling(30).kurt()
     feat['rsi_velocity'] = feat['rsi_14'].diff(3)
